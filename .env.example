# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL (Project Settings → API, or `npx supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (sb_publishable_…). The legacy "anon" JWT key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…) or legacy service_role key. Server-only: used to
# create orders and read promo codes. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=


# Public origin of the site, used for auth email links when no Origin header exists.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
